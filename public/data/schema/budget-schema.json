{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "kommune": {
          "type": "string",
          "minLength": 1,
          "description": "Name der Kommune"
        },
        "ags": {
          "type": "string",
          "pattern": "^\\d{8}$",
          "description": "Amtlicher Gemeindeschlüssel (8 Ziffern)",
          "examples": [
            "09271146"
          ]
        },
        "jahr": {
          "type": "integer",
          "minimum": 1950,
          "maximum": 2100,
          "description": "Haushaltsjahr"
        },
        "einwohner": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Einwohnerzahl, Grundlage für die Pro-Kopf-Werte"
        },
        "status": {
          "type": "string",
          "enum": [
            "Ansatz",
            "Nachtrag",
            "Ergebnis"
          ],
          "description": "Ansatz = Haushaltsplan, Nachtrag = Nachtragshaushaltsplan, Ergebnis = Jahresrechnung"
        },
        "waehrung": {
          "type": "string",
          "const": "EUR"
        },
        "quelle": {
          "description": "Herkunft der Daten, z. B. URL des veröffentlichten Haushaltsplans",
          "type": "string"
        },
        "hinweis": {
          "description": "Freitext-Anmerkung zum Datensatz",
          "type": "string"
        }
      },
      "required": [
        "kommune",
        "ags",
        "jahr",
        "einwohner",
        "status",
        "waehrung"
      ],
      "additionalProperties": false,
      "description": "Stammdaten des Datensatzes"
    },
    "betraege": {
      "type": "object",
      "properties": {
        "vwh": {
          "type": "object",
          "properties": {
            "einnahmen": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[012][0-9]{0,2}$"
              },
              "additionalProperties": {
                "type": "number"
              },
              "description": "Einnahmen des Verwaltungshaushalts: Gruppierungsziffer (Hauptgruppen 0–2, 1–3 Stellen) → Betrag in Euro"
            },
            "ausgaben": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[45678][0-9]{0,2}$"
              },
              "additionalProperties": {
                "type": "number"
              },
              "description": "Ausgaben des Verwaltungshaushalts: Gruppierungsziffer (Hauptgruppen 4–8, 1–3 Stellen) → Betrag in Euro"
            }
          },
          "required": [
            "einnahmen",
            "ausgaben"
          ],
          "additionalProperties": false
        },
        "vmh": {
          "type": "object",
          "properties": {
            "einnahmen": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[3][0-9]{0,2}$"
              },
              "additionalProperties": {
                "type": "number"
              },
              "description": "Einnahmen des Vermögenshaushalts: Gruppierungsziffer (Hauptgruppe 3, 1–3 Stellen) → Betrag in Euro"
            },
            "ausgaben": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^[9][0-9]{0,2}$"
              },
              "additionalProperties": {
                "type": "number"
              },
              "description": "Ausgaben des Vermögenshaushalts: Gruppierungsziffer (Hauptgruppe 9, 1–3 Stellen) → Betrag in Euro"
            }
          },
          "required": [
            "einnahmen",
            "ausgaben"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "vwh",
        "vmh"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "metadata",
    "betraege"
  ],
  "additionalProperties": false,
  "title": "Kameraler Haushaltsdatensatz",
  "description": "Beträge eines kommunalen Haushalts nach dem Gruppierungsplan (KommGrPl), getrennt nach Verwaltungs- und Vermögenshaushalt."
}
