{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "ags": {
        "type": "string",
        "pattern": "^\\d{8}$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "plz": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^\\d{5}$"
        }
      },
      "bundesland": {
        "type": "string",
        "enum": [
          "SH",
          "HH",
          "NI",
          "HB",
          "NW",
          "HE",
          "RP",
          "BW",
          "BY",
          "SL",
          "BE",
          "BB",
          "MV",
          "SN",
          "ST",
          "TH"
        ]
      },
      "jahre": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "jahr": {
              "type": "integer",
              "minimum": 1950,
              "maximum": 2100
            },
            "einwohner": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "file": {
              "type": "string",
              "pattern": "^[\\w.-]+\\.json$"
            }
          },
          "required": [
            "jahr",
            "einwohner",
            "file"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "ags",
      "name",
      "plz",
      "bundesland",
      "jahre"
    ],
    "additionalProperties": false
  }
}
